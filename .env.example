# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
# For local Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant
# For native local PostgreSQL (outside Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# LLM Runtime & Dynamic Model Selection
# Options: 'ollama' (default/mandatory for demo), 'claude', 'openai', or 'mock'
DEFAULT_PROVIDER=ollama

# Local Ollama Daemon Configuration
# For all-in-one Docker Compose setup (containerized Ollama):
OLLAMA_BASE_URL=http://ollama:11434
# For host-native Ollama when backend runs inside Docker:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# For native execution outside Docker:
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Cloud LLM API Keys (Enables instant toggle in UI)
# Leave blank to test graceful degradation / local Ollama only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# RAG & Grounding Guardrails
SIMILARITY_THRESHOLD=0.60
TOP_K_RETRIEVAL=3
EMBEDDING_DIM=384

# Frontend URL (For CORS middleware)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
NEXT_PUBLIC_API_URL=http://localhost:8000
